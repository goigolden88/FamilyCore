{
  // Настройки компилятора семьи (Р-48 «Трапезы»). Приложение берёт их через
  // extends: "./src/shared/tsconfig.base.json" — иначе ядро внутри него
  // собиралось бы по другим правилам, чем здесь.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client"],

    "strict": true,
    // Модель насквозь на опциональных полях. Без этого rec.refs[0]
    // считается string, хотя массив может быть пуст.
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
